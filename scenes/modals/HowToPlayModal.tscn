[node name="RulesText" type="RichTextLabel" parent="CenterContainer/Panel/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.95, 0.9, 0.82, 1)
theme_override_font_sizes/normal_font_size = 32
theme_override_font_sizes/bold_font_size = 36
bbcode_enabled = true
text = "[b]1. THE OBJECTIVE[/b]
Capture all 16 opponent pieces, or immobilize them so they have no legal moves remaining.

[b]2. BOARD SETUP[/b]
Each player starts with exactly 16 pieces:
• Player 1: 16 Crimson Red pieces
• Player 2: 16 Glossy Ivory pieces
• Center Row: 5 empty points for opening moves.

[b]3. MOVEMENT[/b]
On your turn, tap your piece to view legal moves (glowing green/amber dots). Move 1 step along any drawn board line to an adjacent vacant intersection.

[b]4. CAPTURING / JUMPING[/b]
You can capture an opponent piece by hopping directly over it along a straight line into the empty point immediately beyond. The jumped opponent piece is removed.

[b]5. MULTIPLE CAPTURE CHAINS[/b]
After a successful jump, if your piece can make another capture from the landing spot, your turn continues! Keep hopping until no jumps remain.

[b]6. CONTROLS[/b]
• [b]UNDO:[/b] Take back your last move.
• [b]HINT:[/b] Highlights an optimal strategic move.
• [b]RESET:[/b] Restart match from 16 vs 16."

